# Copie este arquivo para ".env" e preencha os valores

# Chave da API da Anthropic (https://console.anthropic.com)
# Usada para interpretar as mensagens (texto e imagem) e transformar em lançamentos/lembretes
ANTHROPIC_API_KEY=

# Porta em que o servidor local vai rodar
PORT=3000

# Número (mesmo formato usado no login, ex: 5511999999999) que vira administrador
# automaticamente ao criar a conta e ganha acesso ao painel /admin.html
ADMIN_PHONE=

# --- WhatsApp Cloud API (Meta) ---
# Crie um app em https://developers.facebook.com/apps, adicione o produto "WhatsApp"
# e pegue esses valores no painel do app.
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-qualquer
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# "App Secret" do painel do app Meta — usado para validar que o webhook realmente
# veio da Meta (assinatura HMAC). Deixe vazio em desenvolvimento local se quiser.
WHATSAPP_APP_SECRET=

# --- Google Agenda (OAuth2) ---
# Crie credenciais OAuth em https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicativo da Web". Ative a "Google Calendar API" no projeto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser exatamente igual ao configurado no Google Cloud Console, ex:
# http://localhost:3000/auth/google/callback (dev) ou https://seudominio.com/auth/google/callback (produção)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Transcrição de áudio (opcional) ---
# URL de um serviço de transcrição de sua escolha (Whisper, Deepgram, etc).
# Sem isso, áudios recebidos avisam o usuário que a transcrição ainda não está disponível.
TRANSCRIPTION_PROVIDER_URL=

# --- Open Finance / conexão bancária (Pluggy) ---
# Crie uma conta em https://dashboard.pluggy.ai e pegue as credenciais do app.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

